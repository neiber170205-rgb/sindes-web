# ---- Copia este archivo como .env y llénalo (no lo subas a GitHub) ----

# Dominio que apunta a la IP del servidor de Vultr (registro A)
DOMAIN=sindes.tudominio.com
# Correo para el certificado HTTPS (Let's Encrypt)
ACME_EMAIL=est_nd_araque@fesc.edu.co

# Genera cada clave con:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Primera cuenta del panel (se crea al cargar el contenido inicial)
ADMIN_EMAIL=est_nd_araque@fesc.edu.co
ADMIN_NAME="Neiber Araque"
ADMIN_PASSWORD=

# Tamaño máximo de cada video que se sube (MB). Opcional.
# MAX_VIDEO_MB=2048
