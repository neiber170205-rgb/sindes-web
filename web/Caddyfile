{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# same-origin: los links personales (/registro/…) nunca viajan a otros sitios
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API: 10 MB para todo, salvo la subida de videos de proyectos (hasta 2 GB)
	handle /api/* {
		@video path_regexp ^/api/admin/projects/[0-9]+/video$
		@normal not path_regexp ^/api/admin/projects/[0-9]+/video$
		request_body @video {
			max_size 2GB
		}
		request_body @normal {
			max_size 10MB
		}
		reverse_proxy api:3000
	}

	# Fotos y logos subidos desde el panel
	handle_path /uploads/* {
		root * /data/uploads
		header Cache-Control "public, max-age=2592000"
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:"
		file_server
	}

	# Archivos del sitio con hash en el nombre: se guardan un año
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Sitio (React): cualquier otra ruta abre index.html
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# www → dominio principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
